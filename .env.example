# Database (Railway Postgres or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recipe_planner

# OpenAI (Instagram + YouTube fallback + recipe chat on web)
OPENAI_API_KEY=sk-...

# Google Gemini (YouTube imports — preferred when set on worker)
GEMINI_API_KEY=
# Optional: gemini-2.0-flash, gemini-2.5-flash, etc.
GEMINI_MODEL=gemini-2.0-flash

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string
# Railway: set NEXTAUTH_URL to your public web URL (https://....up.railway.app)

# Admin login (required — only admins can import/transcribe videos)
AUTH_USERNAME=Admin-1
AUTH_PASSWORD=Pwd-11

# Worker tuning
WORKER_POLL_MS=3000
WORKER_CONCURRENCY=1
MAX_VIDEO_DURATION_SEC=1200
