FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    ca-certificates \
    openssl \
  && pip3 install --break-system-packages yt-dlp \
  && rm -rf /var/lib/apt/lists/*

# Workspace manifests (install before full copy for layer cache)
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/worker/package.json ./apps/worker/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/

# Prisma schema required before generate; skip postinstall scripts
COPY packages/db/prisma ./packages/db/prisma

RUN npm ci --ignore-scripts

COPY packages/db/src ./packages/db/src
COPY packages/shared/src ./packages/shared/src
COPY apps/worker ./apps/worker

COPY scripts/prisma-generate.cjs ./scripts/prisma-generate.cjs
RUN node scripts/prisma-generate.cjs

WORKDIR /app/apps/worker
CMD ["npm", "start"]
