# Worker — Railway: Root Directory = repo root, Dockerfile path = Dockerfile.worker
# Disable HTTP healthcheck for this service (no web server).
FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    ca-certificates \
    openssl \
  && pip3 install --break-system-packages yt-dlp \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN npm ci --ignore-scripts \
  && node scripts/prisma-generate.cjs

CMD ["npm", "run", "start", "--workspace=@recipe-planner/worker"]
