{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker"
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@recipe-planner/worker",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health"
  }
}
