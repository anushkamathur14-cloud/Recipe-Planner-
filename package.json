{
  "name": "recipe-planner",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "prisma": "^6.8.2"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@recipe-planner/web",
    "dev:worker": "npm run dev --workspace=@recipe-planner/worker",
    "build": "npm run build --workspace=@recipe-planner/db && npm run build --workspace=@recipe-planner/shared && npm run build --workspace=@recipe-planner/worker",
    "start:worker": "node apps/worker/dist/index.js",
    "db:generate": "node scripts/prisma-generate.cjs",
    "db:migrate": "npm run migrate --workspace=@recipe-planner/db",
    "db:push": "npm run push --workspace=@recipe-planner/db"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
